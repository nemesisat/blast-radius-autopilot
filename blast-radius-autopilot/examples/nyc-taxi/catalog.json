      "owners": ["team:city-analytics"],
      "defining_query_id": "q_looker_dist"
    },
    {
      "urn": "urn:li:dataset:(urn:li:dataPlatform:dbt,nyc.rpt_trip_metrics,PROD)",
      "name": "rpt_trip_metrics",
      "type": "dbt_model",
      "platform": "dbt",
      "owners": ["team:mobility-data"],
      "dbt_path": "dbt_project/models/rpt_trip_metrics.sql",
      "defining_query_id": "q_dbt_trip_metrics"
    },
    {
      "urn": "urn:li:chart:(powerbi,long_trips)",
