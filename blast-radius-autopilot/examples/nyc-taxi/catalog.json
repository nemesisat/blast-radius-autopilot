{
  "name": "nyc-taxi",
  "sql_dialect": "snowflake",
  "description": "Synthetic operational / time-series taxi-trips catalog. Public/synthetic metadata only.",
  "datasets": [
    {
      "urn": "urn:li:dataset:(urn:li:dataPlatform:snowflake,nyc.trips,PROD)",
      "name": "trips",
      "sql_name": "nyc.trips",
      "platform": "snowflake",
      "owners": ["team:mobility-data"],
      "schema": {
        "trip_id": "NUMBER",
        "pickup_ts": "TIMESTAMP",
        "dropoff_ts": "TIMESTAMP",
        "passenger_count": "NUMBER",
        "trip_distance": "FLOAT",
        "fare_amount": "FLOAT",
        "pickup_zone": "VARCHAR",
        "payment_type": "VARCHAR"
      }
    }
  ],
  "assets": [
    {
      "urn": "urn:li:dashboard:(looker,avg_distance_by_zone)",
      "name": "Avg Distance by Zone",
