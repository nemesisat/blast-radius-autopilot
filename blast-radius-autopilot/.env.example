# Copy to .env (gitignored) and fill in. The token NEVER goes in the repo.

# DataHub GMS / API (local quickstart default)
DATAHUB_GMS_URL=http://localhost:8080

# Access token: DataHub UI -> Settings -> Access Tokens -> Generate
DATAHUB_TOKEN=

# DataHub MCP server (reads + writes). Enable mutation tools to write back.
DATAHUB_MCP_URL=http://localhost:8080/mcp
TOOLS_IS_MUTATION_ENABLED=true

# Optional: LLM for the assessment narrative (falls back to a deterministic template)
ANTHROPIC_API_KEY=
