# Copy to .env and fill in. Never commit .env.

# DataHub GMS / API endpoint (local Quickstart default)
DATAHUB_GMS_URL=http://localhost:8080
# DataHub UI (for GraphiQL at /api/graphiql) — usually :9002 on Quickstart
DATAHUB_FRONTEND_URL=http://localhost:9002
# Personal access token: create in DataHub UI -> Settings -> Access Tokens
DATAHUB_TOKEN=

# DataHub MCP server endpoint (self-hosted GMS). Enable mutation tools on the
# server with TOOLS_IS_MUTATION_ENABLED=true so the agent can write back.
DATAHUB_MCP_URL=http://localhost:8080/mcp

# The model the sentinel monitors (set after running the seed script)
TARGET_MODEL_URN=urn:li:mlModel:(urn:li:dataPlatform:mlflow,nyc_taxi_fare_predictor,PROD)

# LLM for the agent narrative (optional; the rule-based path works without it)
ANTHROPIC_API_KEY=
